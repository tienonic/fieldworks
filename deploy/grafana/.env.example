# Copy this file to .env and replace every change-before-starting value.
# Do not commit .env.

INFLUX_ADMIN_USER=fieldworks-admin
INFLUX_ADMIN_PASSWORD=change-before-starting-influx-password
INFLUX_ADMIN_TOKEN=change-before-starting-influx-token
INFLUX_GRAFANA_TOKEN=change-before-starting-read-only-token
INFLUX_ORG=fieldworks
INFLUX_BUCKET=fieldworks_test
INFLUX_RETENTION=90d

GRAFANA_ADMIN_USER=fieldworks-admin
GRAFANA_ADMIN_PASSWORD=change-before-starting-grafana-password

GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
INFLUX_BIND_ADDRESS=127.0.0.1
INFLUX_PORT=8086
